# AERIS Environment Variables
# Copy this file to .env and fill in your API keys
# The .env file is gitignored and will not be committed to the repository

# OpenAQ API key (required for static mode)
# Get your free API key at: https://openaq.org/#/develop
OPENAQ_API_KEY=your_openaq_api_key_here

# Google Maps Air Quality API key (required for dynamic mode with gmaps backend)
# Enable the Air Quality API in Google Cloud Console and create an API key
# https://console.cloud.google.com/
GOOGLE_MAPS_AIR_QUALITY_API_KEY=your_google_maps_api_key_here

# PurpleAir API key (required for dynamic mode with xgb backend)
# Get your API key at: https://www2.purpleair.com/community/account
PURPLEAIR_API_KEY=your_purpleair_api_key_here

# AccuWeather Air Quality API key (optional, for current/forecast index inspection)
# The returned provider index is not used as a pollutant concentration.
ACCUWEATHER_API_KEY=your_accuweather_api_key_here

# Google Earth Engine project ID (required for dynamic mode with xgb backend)
# Set your GEE project ID. You can also set this via: earthengine set_project <PROJECT_ID>
# Required for LULC (Land Use/Land Cover) variables: OS, WA, ISF, TC, EL
AERIS_EXPOSURE_GEE_PROJECT=your_gee_project_id_here
