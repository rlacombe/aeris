{"type":"item.completed","item":{"id":"item_41","type":"mcp_tool_call","server":"aeris","tool":"describe_aeris_tools","arguments":{},"result":{"content":[{"type":"text","text":"{\n  \"tools\": [\n    {\n      \"name\": \"load_cohort\",\n      \"description\": \"Load a cohort CSV file, auto-detect static/dynamic mode, and return summary statistics (size, columns, date range, geographic coverage).\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"path\": {\n            \"type\": \"string\",\n            \"description\": \"Path to the CSV file\"\n          }\n        },\n        \"required\": [\n          \"path\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"plan_exposure\",\n      \"description\": \"Return a no-download OpenAQ workload plan for the loaded static cohort. Call this before requesting researcher approval for an exposure run.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"pm25\",\n              \"pm10\",\n              \"no2\",\n              \"o3\",\n              \"so2\",\n              \"co\"\n            ]\n          },\n          \"country\": {\n            \"type\": \"string\",\n            \"description\": \"ISO alpha-2 country code (default: us).\"\n          },\n          \"n_stations\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"temporal_resolution\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"daily\",\n              \"hourly\"\n            ]\n          },\n          \"location_strategy\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"auto\",\n              \"per_subject\",\n              \"catalog\"\n            ]\n          },\n          \"search_radius_km\": {\n            \"type\": \"number\",\n            \"exclusiveMinimum\": 0,\n            \"maximum\": 200\n          }\n        },\n        \"required\": [\n          \"pollutant\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"estimate_exposure\",\n      \"description\": \"Run exposure estimation for the loaded cohort. For static mode, specify a pollutant (pm25, pm10, no2, o3, so2, co, or 'all'). For dynamic mode, specify the backend (gmaps or xgb). Supports IDW multi-station averaging, outlier detection, and completeness QC for static mode.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"description\": \"Pollutant to estimate (static mode). One of: pm25, pm10, no2, o3, so2, co, or 'all'\"\n          },\n          \"backend\": {\n            \"type\": \"string\",\n            \"description\": \"Dynamic mode backend: 'gmaps' (default) or 'xgb'\",\n            \"enum\": [\n              \"gmaps\",\n              \"xgb\"\n            ]\n          },\n          \"country\": {\n            \"type\": \"string\",\n            \"description\": \"ISO country code for geocoding (default: 'us')\"\n          },\n          \"n_stations\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of stations for IDW averaging (default: 1, nearest only)\"\n          },\n          \"outlier_detection\": {\n            \"type\": \"boolean\",\n            \"description\": \"Enable IQR outlier removal before computing metrics (default: false)\"\n          },\n          \"min_completeness\": {\n            \"type\": \"number\",\n            \"description\": \"Minimum completeness percentage (0-100) for QC flagging\"\n          },\n          \"temporal_resolution\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"daily\",\n              \"hourly\"\n            ],\n            \"description\": \"OpenAQ retrieval resolution. Use daily for daily health analyses to reduce API volume; hourly is retained for sub-daily analyses.\"\n          },\n          \"location_strategy\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"auto\",\n              \"per_subject\",\n              \"catalog\"\n            ],\n            \"description\": \"Station-discovery strategy. Auto can use a cached country catalog for large single-country cohorts and otherwise uses per-subject queries.\"\n          },\n          \"search_radius_km\": {\n            \"type\": \"number\",\n            \"exclusiveMinimum\": 0,\n            \"maximum\": 200,\n            \"description\": \"Maximum city-to-monitor search distance in kilometres.\"\n          },\n          \"approved_plan_id\": {\n            \"type\": \"string\",\n            \"description\": \"Immutable plan identifier approved by the researcher in interactive mode.\"\n          }\n        }\n      },\n      \"requires_researcher_approval\": true\n    },\n    {\n      \"name\": \"approve_exposure_plan\",\n      \"description\": \"Bind explicit researcher approval to one immutable exposure plan.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"plan_id\": {\n            \"type\": \"string\"\n          },\n          \"researcher_approved\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"plan_id\",\n          \"researcher_approved\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"estimate_boundary_exposure\",\n      \"description\": \"Estimate an ambient pollutant record for an explicit administrative boundary. Use either a researcher-supplied GeoJSON file or geoBoundaries ISO3/ADM selection. The result is an unweighted mean of monitor-level means within the polygon, with station coverage and boundary provenance.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"pm25\",\n              \"pm10\",\n              \"no2\",\n              \"o3\",\n              \"so2\",\n              \"co\"\n            ]\n          },\n          \"start_date\": {\n            \"type\": \"string\",\n            \"description\": \"Inclusive ISO date.\"\n          },\n          \"end_date\": {\n            \"type\": \"string\",\n            \"description\": \"Inclusive ISO date.\"\n          },\n          \"iso3\": {\n            \"type\": \"string\",\n            \"description\": \"ISO-3166 alpha-3 country code for geoBoundaries.\"\n          },\n          \"adm_level\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"maximum\": 5\n          },\n          \"boundary_name\": {\n            \"type\": \"string\",\n            \"description\": \"Administrative unit name or GeoJSON feature name.\"\n          },\n          \"boundary_geojson_path\": {\n            \"type\": \"string\",\n            \"description\": \"Local GeoJSON path; preferred for a study-specific boundary.\"\n          },\n          \"min_completeness\": {\n            \"type\": \"number\",\n            \"minimum\": 0,\n            \"maximum\": 100\n          },\n          \"temporal_resolution\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"daily\",\n              \"hourly\"\n            ],\n            \"description\": \"OpenAQ retrieval resolution. Use daily when the health outcome and intended analysis are daily.\"\n          },\n          \"researcher_approved\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"pollutant\",\n          \"start_date\",\n          \"end_date\"\n        ]\n      },\n      \"requires_researcher_approval\": true\n    },\n    {\n      \"name\": \"estimate_boundary_exposure_batch\",\n      \"description\": \"Estimate one pollutant for every selected feature in a boundary GeoJSON. Uses deterministic ordering, atomic per-unit checkpoints, and combined daily output. In self-driving mode, use deterministic chunks of at most 5 named boundaries.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"pm25\",\n              \"pm10\",\n              \"no2\",\n              \"o3\",\n              \"so2\",\n              \"co\"\n            ]\n          },\n          \"start_date\": {\n            \"type\": \"string\"\n          },\n          \"end_date\": {\n            \"type\": \"string\"\n          },\n          \"boundary_geojson_path\": {\n            \"type\": \"string\"\n          },\n          \"boundary_names\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"min_completeness\": {\n            \"type\": \"number\",\n            \"minimum\": 0,\n            \"maximum\": 100\n          },\n          \"temporal_resolution\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"daily\",\n              \"hourly\"\n            ]\n          },\n          \"checkpoint_path\": {\n            \"type\": \"string\"\n          },\n          \"max_stations\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"researcher_approved\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"pollutant\",\n          \"start_date\",\n          \"end_date\",\n          \"boundary_geojson_path\"\n        ]\n      },\n      \"requires_researcher_approval\": true\n    },\n    {\n      \"name\": \"get_exposure_summary\",\n      \"description\": \"Get summary statistics for the current exposure results: mean, SD, range, n with data, distance distribution.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"description\": \"Which pollutant results to summarize (defaults to first available)\"\n          }\n        }\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"get_raw_data\",\n      \"description\": \"Get raw hourly air quality measurements. A subject_id is required for point exposure and omitted for an administrative-boundary record.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"subject_id\": {\n            \"type\": \"string\",\n            \"description\": \"The subject identifier\"\n          },\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"description\": \"Pollutant (defaults to first available)\"\n          }\n        }\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"get_daily_data\",\n      \"description\": \"Get daily aggregated air quality data. A subject_id is required for point exposure and omitted for an administrative-boundary record.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"subject_id\": {\n            \"type\": \"string\",\n            \"description\": \"The subject identifier\"\n          },\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"description\": \"Pollutant (defaults to first available)\"\n          }\n        }\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"compare_metrics\",\n      \"description\": \"Compare exposure metrics (mean, median, p75, p95) across pollutants or between different estimation approaches.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutants\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"List of pollutants to compare (defaults to all available)\"\n          }\n        }\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"convert_to_aqi\",\n      \"description\": \"Convert a pollutant concentration to EPA AQI value and category.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"description\": \"One of: pm25, pm10, no2, o3, so2, co\"\n          },\n          \"concentration\": {\n            \"type\": \"number\",\n            \"description\": \"Concentration value to convert\"\n          }\n        },\n        \"required\": [\n          \"pollutant\",\n          \"concentration\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"get_accuweather_air_quality\",\n      \"description\": \"Retrieve AccuWeather's current/forecast air-quality index, category, and dominant-pollutant information for a coordinate. The response is a provider index and must not be used as a pollutant concentration.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"latitude\": {\n            \"type\": \"number\"\n          },\n          \"longitude\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"latitude\",\n          \"longitude\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"export_results\",\n      \"description\": \"Export exposure results to a file. Supports CSV, GeoJSON, and long-format tidy CSV.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"path\": {\n            \"type\": \"string\",\n            \"description\": \"Output file path\"\n          },\n          \"format\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"csv\",\n              \"geojson\",\n              \"long_format\"\n            ],\n            \"description\": \"Export format (default: csv)\"\n          },\n          \"pollutant\": {\n            \"type\": \"string\",\n            \"description\": \"Which pollutant results to export (defaults to first available)\"\n          }\n        },\n        \"required\": [\n          \"path\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"get_station_info\",\n      \"description\": \"Get monitoring station metadata for the exposure results. Static mode only.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"subject_id\": {\n            \"type\": \"string\",\n            \"description\": \"Optional: filter to a specific subject\"\n          }\n        }\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"web_search\",\n      \"description\": \"Search the web for scientific literature, exposure guidelines, or methodological references.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"query\": {\n            \"type\": \"string\",\n            \"description\": \"Search query (e.g., 'PM2.5 childhood asthma epidemiology')\"\n          },\n          \"num_results\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of results to return (default 5, max 10)\"\n          }\n        },\n        \"required\": [\n          \"query\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"get_decision_log\",\n      \"description\": \"Return the current analytical decision log.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"lock_reanalysis_invariants\",\n      \"description\": \"Lock only the scientific invariants and safety bounds for a self-driving reanalysis; leave retrieval and implementation choices open.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"study_id\": {\n            \"type\": \"string\"\n          },\n          \"research_question\": {\n            \"type\": \"string\"\n          },\n          \"target_outcome_and_population\": {\n            \"type\": \"string\"\n          },\n          \"pollutants\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"principal_contrast\": {\n            \"type\": \"string\"\n          },\n          \"principal_variants\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"The explicit fitted comparison selected as the reanalysis target. Ordinarily provide one label anchored to a table, figure, model, or results sentence. Include another variant only when it forms part of the same prespecified target and will receive its own fitted result.\"\n          },\n          \"broad_geography\": {\n            \"type\": \"string\"\n          },\n          \"target_geographic_units\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"minimum\": 1,\n            \"description\": \"Article-reported count of geographic units, when stated. Leave null when the article gives no count.\"\n          },\n          \"target_geographic_unit_type\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"Article-reported unit type, such as county or municipality.\"\n          },\n          \"start_date\": {\n            \"type\": \"string\"\n          },\n          \"end_date\": {\n            \"type\": \"string\"\n          },\n          \"prohibited_evidence\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"article_evidence\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"artifact\": {\n                  \"type\": \"string\",\n                  \"description\": \"Saved article or supplement path.\"\n                },\n                \"finding\": {\n                  \"type\": \"string\",\n                  \"description\": \"Scientific specification supported by the artifact.\"\n                }\n              },\n              \"required\": [\n                \"artifact\",\n                \"finding\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"article_evidence_map\": {\n            \"type\": \"object\",\n            \"description\": \"Optional structured notes from article inspection. This is evidence, not a compliance checklist, and may be partial when full text is unavailable.\"\n          }\n        },\n        \"required\": [\n          \"study_id\",\n          \"research_question\",\n          \"target_outcome_and_population\",\n          \"pollutants\",\n          \"principal_contrast\",\n          \"principal_variants\",\n          \"broad_geography\",\n          \"start_date\",\n          \"end_date\",\n          \"prohibited_evidence\",\n          \"article_evidence\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"update_research_notebook\",\n      \"description\": \"Persist restart-safe research state: evidence, decisions, blockers, and next actions.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"phas