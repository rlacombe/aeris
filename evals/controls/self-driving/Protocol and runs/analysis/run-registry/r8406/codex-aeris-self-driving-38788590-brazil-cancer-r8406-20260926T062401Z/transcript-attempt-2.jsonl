pe\": \"string\"\n                }\n              },\n              \"exact_file_search_results_followed\": {\n                \"type\": \"boolean\"\n              },\n              \"geographic_batching_applicable\": {\n                \"type\": \"boolean\"\n              },\n              \"geographic_batching_attempted\": {\n                \"type\": \"boolean\"\n              },\n              \"geographic_batches_exhausted\": {\n                \"type\": \"boolean\"\n              },\n              \"eligible_units\": {\n                \"type\": \"integer\",\n                \"minimum\": 1\n              },\n              \"exposure_units_attempted\": {\n                \"type\": \"integer\",\n                \"minimum\": 0\n              },\n              \"fidelity_levels_evaluated\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"pending_requests\": {\n                \"type\": \"integer\",\n                \"minimum\": 0\n              },\n              \"evidence_artifacts\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"stop_counterexamples_tested\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"stop_counterexample_evidence\": {\n                \"type\": \"string\"\n              },\n              \"public_dataset_search_attempts\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"query\": {\n                      \"type\": \"string\"\n                    },\n                    \"source_role\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"outcome\",\n                        \"exposure\",\n                        \"covariate\",\n                        \"article\"\n                      ]\n                    },\n                    \"query_strategy\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"artifact_exact\",\n                        \"source_ecosystem\",\n                        \"native_language\",\n                        \"package_registry\"\n                      ]\n                    },\n                    \"route_type\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"dataset_catalog\",\n                        \"code_repository\",\n                        \"web_search\",\n                        \"package_registry\"\n                      ]\n                    },\n                    \"evidence_artifact\": {\n                      \"type\": \"string\"\n                    },\n                    \"candidates\": {\n                      \"type\": \"array\",\n                      \"items\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                          \"url\": {\n                            \"type\": \"string\"\n                          },\n                          \"disposition\": {\n                            \"type\": \"string\",\n                            \"enum\": [\n                              \"exercised_usable\",\n                              \"exercised_unusable\",\n                              \"irrelevant\"\n                            ]\n                          },\n                          \"evidence_artifact\": {\n                            \"type\": \"string\"\n                          },\n                          \"request_url\": {\n                            \"type\": \"string\"\n                          },\n                          \"command\": {\n                            \"type\": \"string\"\n                          },\n                          \"response_status\": {\n                            \"type\": \"integer\"\n                          },\n                          \"captured_error\": {\n                            \"type\": \"string\"\n                          },\n                          \"bytes_returned\": {\n                            \"type\": \"integer\"\n                          },\n                          \"records_returned\": {\n                            \"type\": \"integer\"\n                          },\n                          \"schema_or_format_inspection\": {\n                            \"type\": \"string\"\n                          },\n                          \"rationale\": {\n                            \"type\": \"string\"\n                          }\n                        },\n                        \"required\": [\n                          \"url\",\n                          \"disposition\",\n                          \"evidence_artifact\"\n                        ]\n                      }\n                    }\n                  },\n                  \"required\": [\n                    \"query\",\n                    \"source_role\",\n                    \"query_strategy\",\n                    \"route_type\",\n                    \"evidence_artifact\",\n                    \"candidates\"\n                  ]\n                }\n              }\n            }\n          },\n          \"final_analysis_checklist\": {\n            \"type\": \"object\",\n            \"description\": \"For fitted autonomous runs, include analysis_adequacy, outcome_accounting, design_fidelity, and scientific_review. Adequacy records observations, parameters, eligible and included geographic units, coverage, variation, justification, and evidence. Outcome accounting reconciles source records, analysis events, and any article-reported total. Design fidelity records the article and final model logic and contrasts, comparison status, preserved and changed dimensions, threshold and sample-selection provenance, and evidence. The scientific review records issues, repairs, unresolved limits, and whether this is the strongest supported analysis.\"\n          },\n          \"notes\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"study_id\",\n          \"fidelity_class\",\n          \"status\",\n          \"preserved_dimensions\",\n          \"deviations\",\n          \"evidence_artifacts\",\n          \"reported_variants\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"record_study_design\",\n      \"description\": \"Validate and persist a researcher-approved study-design record before exposure estimation.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"research_question\": {\n            \"type\": \"string\"\n          },\n          \"outcome\": {\n            \"type\": \"string\"\n          },\n          \"pollutant\": {\n            \"type\": \"string\"\n          },\n          \"location_unit\": {\n            \"type\": \"string\"\n          },\n          \"time_window\": {\n            \"type\": \"string\"\n          },\n          \"temporal_aggregation\": {\n            \"type\": \"string\"\n          },\n          \"assignment_rule\": {\n            \"type\": \"string\"\n          },\n          \"covariates\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"analysis_handoff\": {\n            \"type\": \"string\"\n          },\n          \"sensitivity_analyses\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"researcher_approved\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"research_question\",\n          \"outcome\",\n          \"pollutant\",\n          \"location_unit\",\n          \"time_window\",\n          \"assignment_rule\",\n          \"researcher_approved\"\n        ]\n      },\n      \"requires_researcher_approval\": true\n    },\n    {\n      \"name\": \"list_artifacts\",\n      \"description\": \"List durable study datasets and result artifacts with compact metadata.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"describe_artifact\",\n      \"description\": \"Describe a durable artifact without returning its full table.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"artifact_id\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"artifact_id\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"sample_artifact\",\n      \"description\": \"Return a bounded sample from a durable artifact.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"artifact_id\": {\n            \"type\": \"string\"\n          },\n          \"limit\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 200\n          },\n          \"columns\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"artifact_id\"\n        ]\n      },\n      \"requires_researcher_approval\": false\n    },\n    {\n      \"name\": \"query_artifact\",\n      \"description\": \"Compute a bounded row count, missingness, value-count, or numeric summary.\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"artifact_id\": {\n