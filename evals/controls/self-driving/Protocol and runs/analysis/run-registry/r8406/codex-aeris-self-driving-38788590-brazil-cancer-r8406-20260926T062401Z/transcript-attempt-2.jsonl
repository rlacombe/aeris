tive\",\"value\":\"Arantes, Caio Simplicio\"},\"authorAffiliation\":{\"typeName\":\"authorAffiliation\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Universidade Estadual de Campinas (UNICAMP). Faculdade de Engenharia Agrícola\"},\"authorIdentifierScheme\":{\"typeName\":\"authorIdentifierScheme\",\"multiple\":false,\"typeClass\":\"controlledVocabulary\",\"value\":\"ORCID\"},\"authorIdentifier\":{\"typeName\":\"authorIdentifier\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"https://orcid.org/0009-0006-6926-9368\"}},{\"authorName\":{\"typeName\":\"authorName\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Andrade Júnior, Valter Lacerda de\"},\"authorAffiliation\":{\"typeName\":\"authorAffiliation\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Universidade Estadual de Campinas (UNICAMP). Faculdade de Ciências Médicas\"},\"authorIdentifierScheme\":{\"typeName\":\"authorIdentifierScheme\",\"multiple\":false,\"typeClass\":\"controlledVocabulary\",\"value\":\"ORCID\"},\"authorIdentifier\":{\"typeName\":\"authorIdentifier\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"https://orcid.org/0000-0001-8434-7092\"}},{\"authorName\":{\"typeName\":\"authorName\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Pacagnella, Rodolfo de Carvalho\"},\"authorAffiliation\":{\"typeName\":\"authorAffiliation\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Universidade Estadual de Campinas (UNICAMP). Faculdade de Ciências Médicas\"},\"authorIdentifierScheme\":{\"typeName\":\"authorIdentifierScheme\",\"multiple\":false,\"typeClass\":\"controlledVocabulary\",\"value\":\"ORCID\"},\"authorIdentifier\":{\"typeName\":\"authorIdentifier\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"https://orcid.org/0000-0002-5739-0009\"}}]},{\"typeName\":\"datasetContact\",\"multiple\":true,\"typeClass\":\"compound\",\"value\":[{\"datasetContactName\":{\"typeName\":\"datasetContactName\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"França, Breno Bernard Nicolau de\"},\"datasetContactAffiliation\":{\"typeName\":\"datasetContactAffiliation\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Universidade Estadual de Campinas (UNICAMP). Instituto de Computação\"},\"datasetContactEmail\":{\"typeName\":\"datasetContactEmail\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"bfranca@unicamp.br\"}}]},{\"typeName\":\"dsDescription\",\"multiple\":true,\"typeClass\":\"compound\",\"value\":[{\"dsDescriptionValue\":{\"typeName\":\"dsDescriptionValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Climaterna is a comprehensive dataset integrating public data from validated sources, including the Mortality Information System (SIM) and the Live Births Information System (SINASC) of DATASUS, the Brazilian Daily Weather Gridded Data (BR-DWGD), and pollution data from the CMIP6 platform. The dataset comprises anonymized microdata on all births and deaths across Brazilian municipalities, with daily granularity from 2011 to 2022. It also includes annual climate and pollution data for the same period and geographic scope. This integrated dataset enables diverse analyses exploring the relationships between health and environmental variables, particularly focusing on maternal and neonatal health outcomes in Brazil. By combining data from officially validated sources, this dataset supports robust research in epidemiology, public health, and environmental sciences. Furthermore, it can also support journalistic reporting and serve as a reliable resource for anyone interested in cross-referencing climate, health, and pollution data.\"}}]},{\"typeName\":\"subject\",\"multiple\":true,\"typeClass\":\"controlledVocabulary\",\"value\":[\"Earth and Environmental Sciences\",\"Medicine, Health and Life Sciences\",\"Social Sciences\"]},{\"typeName\":\"keyword\",\"multiple\":true,\"typeClass\":\"compound\",\"value\":[{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Maternal health\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Neonatal outcomes\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Epidemiology\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Environmental variables\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Public health\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Pollution data\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Climate analysis\"}},{\"keywordValue\":{\"typeName\":\"keywordValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Dataset integration\"}}]},{\"typeName\":\"language\",\"multiple\":true,\"typeClass\":\"controlledVocabulary\",\"value\":[\"Portuguese\"]},{\"typeName\":\"grantNumber\",\"multiple\":true,\"typeClass\":\"compound\",\"value\":[{\"grantNumberAgency\":{\"typeName\":\"grantNumberAgency\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Lacuna Fund\"},\"grantNumberValue\":{\"typeName\":\"grantNumberValue\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"19497.59\"}}]},{\"typeName\":\"depositor\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"Bernard Nicolau de França, Breno\"},{\"typeName\":\"dateOfDeposit\",\"multiple\":false,\"typeClass\":\"primitive\",\"value\":\"2024-11-22\"},{\"typeName\":\"dataSources\",\"multiple\":true,\"typeClass\":\"primitive\",\"value\":[\"SIM - http://tabnet.datasus.gov.br/cgi/tabcgi.exe?sim/cnv/obt10uf.def\",\"SINASC - https://svs.aids.gov.br/daent/cgiae/sinasc/\",\"BR-DWGD - https://github.com/AlexandreCandidoXavier/BR-DWGD\",\"CMIP6 - https://pcmdi.llnl.gov/CMIP6/\"]},{\"typeName\":\"lgpdPermission\",\"multiple\":true,\"typeClass\":\"controlledVocabulary\",\"value\":[\"os dados que serão depositados estão de acordo com a LGPD (Lei Geral de Proteção de Dados)\",\"o projeto que gerou os dados foi aprovado pelo Comite de Ética em Pesquisa da Unicamp ou não envolve questões que requeiram tal aprovação\"]}]}},\"files\":[{\"label\":\"cities_geocodes.csv\",\"restricted\":false,\"version\":1,\"datasetVersionId\":1613,\"dataFile\":{\"id\":17718,\"persistentId\":\"\",\"filename\":\"cities_geocodes.csv\",\"contentType\":\"text/csv\",\"friendlyType\":\"Comma Separated Values\",\"filesize\":371105,\"storageIdentifier\":\"s3://redu:197aeb3bdf1-9a8577faad3d\",\"rootDataFileId\":-1,\"md5\":\"7526871c3fe448aa998b342675eea38a\",\"checksum\":{\"type\":\"MD5\",\"value\":\"7526871c3fe448aa998b342675eea38a\"},\"tabularData\":false,\"creationDate\":\"2025-06-26\",\"publicationDate\":\"2025-07-01\",\"fileAccessRequest\":false}},{\"label\":\"climate.zip\",\"restricted\":false,\"version\":1,\"datasetVersionId\":1613,\"dataFile\":{\"id\":17720,\"persistentId\":\"\",\"filename\":\"climate.zip\",\"contentType\":\"application/zip\",\"friendlyType\":\"ZIP Archive\",\"filesize\":2433637149,\"storageIdentifier\":\"s3://redu:197aecf02f0-0b217dbfb950\",\"rootDataFileId\":-1,\"md5\":\"4e6650488d012bf316877eeb110e2ed0\",\"checksum\":{\"type\":\"MD5\",\"value\":\"4e6650488d012bf316877eeb110e2ed0\"},\"tabularData\":false,\"creationDate\":\"2025-06-26\",\"publicationDate\":\"2025-07-01\",\"fileAccessRequest\":false}},{\"label\":\"health.zip\",\"restricted\":false,\"version\":1,\"datasetVersionId\":1613,\"dataFile\":{\"id\":17721,\"persistentId\":\"\",\"filename\":\"health.zip\",\"contentType\":\"application/zip\",\"friendlyType\":\"ZIP Archive\",\"filesize\":2779832439,\"storageIdentifier\":\"s3://redu:197aed711d1-dd0aa9208640\",\"rootDataFileId\":-1,\"md5\":\"274f7b2b3cb35f2126c5dc2e99ff9cf1\",\"checksum\":{\"type\":\"MD5\",\"value\":\"274f7b2b3cb35f2126c5dc2e99ff9cf1\"},\"tabularData\":false,\"creationDate\":\"2025-06-26\",\"publicationDate\":\"2025-07-01\",\"fileAccessRequest\":false}},{\"label\":\"pollution.zip\",\"restricted\":false,\"version\":1,\"datasetVersionId\":1613,\"dataFile\":{\"id\":17719,\"persistentId\":\"\",\"filename\":\"pollution.zip\",\"contentType\":\"application/zip\",\"friendlyType\":\"ZIP Archive\",\"filesize\":61861647,\"storageIdentifier\":\"s3://redu:197aeb693fd-c8fb9fa1fde5\",\"rootDataFileId\":-1,\"md5\":\"71d7c179c97cdf847a0345b41f89f307\",\"checksum\":{\"type\":\"MD5\",\"value\":\"71d7c179c97cdf847a0345b41f89f307\"},\"tabularData\":false,\"creationDate\":\"2025-06-26\",\"publicationDate\":\"2025-07-01\",\"fileAccessRequest\":false}},{\"label\":\"README.md\",\"restricted\":false,\"version\":1,\"datasetVersionId\":1613,\"dataFile\":{\"id\":17717,\"persistentId\":\"\",\"filename\":\"README.md\",\"contentType\":\"text/markdown\",\"friendlyType\":\"Markdown Text\",\"filesize\":3554,\"storageIdentifier\":\"s3://redu:197aeb0d3b4-edaddf0cf998\",\"rootDataFileId\":-1,\"md5\":\"6808e1ded3b3ad9c3960a7f924300650\",\"checksum\":{\"type\":\"MD5\",\"value\":\"6808e1ded3b3ad9c3960a7f924300650\"},\"tabularData\":false,\"creationDate\":\"2025-06-26\",\"publicationDate\":\"2025-07-01\",\"fileAccessRequest\":false}}]}}}\n--\n/output/recovery/climaterna-README.md:1:**Climaterna** provides a comprehensive dataset integrating public data from validated sources, including the Mortality Information System (SIM) and the Live Births Information System (SINASC) of DATASUS, the Brazilian Daily Weather Gridded Data (BR-DWGD), and pollution data from the CMIP6 platform. The dataset comprises anonymized microdata on all births and deaths across Brazilian municipalities, with daily granularity from 2010 to 2022. It also includes annual climate and pollution data for the same period and geographic scope. This integrated dataset enables diverse analyses exploring the relationships between health and environmental variables, particularly focusing on Brazil's maternal and neonatal health outcomes. By combining data from officially validated sources, this dataset supports robust research in epidemiology, public health, and environmental sciences. Furthermore, it can support journalistic reporting and be a reliable resource for anyone interested in cross-referencing climate, health, and pollution data.\n/output/recovery/climaterna-README.md-2-\n/output/recovery/climaterna-README.md-3-::: info\n/output/recovery/climaterna-README.md:4:All the data is available in **parquet** (tabular) format, enabling efficient access and processing capabilities. **The linkage among files is given by city identifiers, which share consistent values across the datasets**. For SIM and SINASC data, the city ID is the field CODMUNRES. For climate and pollution, the city code is the CODE_MUNI field. Additionally, the file cities_geocodes.csv contains these codes as 'geocodigo' (discarding the last digit) along with their latitude and longitude.\n/output/recovery/climaterna-README.md-5-\n/output/recovery/climaterna-README.md-6-:::\n/output/recovery/climaterna-README.md-7-\n--\n/output/recovery/climaterna-README.md-16-\n/output/recovery/climaterna-README.md-17-# Health Data Documentation\n/output/recovery/climaterna-README.md-18-\n/output/recovery/climaterna-README.md:19:The health data documentation is available [HERE](https://unidrive.unicamp.br/index.php/s/Cw3MHrbWZFTiqAp). \n/output/recovery/climaterna-README.md-20-\n/output/recovery/climaterna-README.md-21-# Pollution Data Documentation\n/output/recovery/climaterna-README.md-22-\n/output/recovery/climaterna-README.md:23:The health data documentation is available [HERE](https://unidrive.unicamp.br/index.php/s/4MYpFzW3tzPC2DJ).\n/output/recovery/climaterna-README.md-24-\n/output/recovery/climaterna-README.md-25-::: info\n/output/recovery/climaterna-README.md-26-***How to cite Climaterna?***  \n### health logs / headers\n## /output/recovery/health-download.log\n/outpu