t":{"type":"string","description":"Pollutant to estimate (static mode). One of: pm25, pm10, no2, o3, so2, co, or 'all'"},"backend":{"type":"string","description":"Dynamic mode backend: 'gmaps' (default) or 'xgb'","enum":["gmaps","xgb"]},"country":{"type":"string","description":"ISO country code for geocoding (default: 'us')"},"n_stations":{"type":"integer","description":"Number of stations for IDW averaging (default: 1, nearest only)"},"outlier_detection":{"type":"boolean","description":"Enable IQR outlier removal before computing metrics (default: false)"},"min_completeness":{"type":"number","description":"Minimum completeness percentage (0-100) for QC flagging"},"temporal_resolution":{"type":"string","enum":["daily","hourly"],"description":"OpenAQ retrieval resolution. Use daily for daily health analyses to reduce API volume; hourly is retained for sub-daily analyses."},"location_strategy":{"type":"string","enum":["auto","per_subject","catalog"],"description":"Station-discovery strategy. Auto can use a cached country catalog for large single-country cohorts and otherwise uses per-subject queries."},"search_radius_km":{"type":"number","exclusiveMinimum":0,"maximum":200,"description":"Maximum city-to-monitor search distance in kilometres."},"approved_plan_id":{"type":"string","description":"Immutable plan identifier approved by the researcher in interactive mode."}}},"requires_researcher_approval":true},{"name":"approve_exposure_plan","description":"Bind explicit researcher approval to one immutable exposure plan.","input_schema":{"type":"object","properties":{"plan_id":{"type":"string"},"researcher_approved":{"type":"boolean"}},"required":["plan_id","researcher_approved"]},"requires_researcher_approval":false},{"name":"estimate_boundary_exposure","description":"Estimate an ambient pollutant record for an explicit administrative boundary. Use either a researcher-supplied GeoJSON file or geoBoundaries ISO3/ADM selection. The result is an unweighted mean of monitor-le