ype\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"role\", \"url\", \"route_origin\", \"retrieved\"],\n        \"properties\": {\n          \"role\": {\"enum\": [\"outcome\", \"exposure\", \"covariate\", \"weather\", \"boundary\", \"other\"]},\n          \"url\": {\"type\": \"string\"},\n          \"route_origin\": {\n            \"enum\": [\"article_named\", \"article_linked\", \"agent_discovered\"]\n          },\n          \"retrieved\": {\"type\": \"boolean\"},\n          \"sha256\": {\"type\": [\"string\", \"null\"]},\n          \"evidence_artifact\": {\"type\": [\"string\", \"null\"]}\n        }\n      }\n    },\n    \"substitutions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"dimension\", \"change_type\", \"published\", \"reanalysis\", \"reason\"],\n        \"properties\": {\n          \"dimension\": {\n            \"enum\": [\n              \"exposure\", \"outcome\", \"geography\", \"period\", \"covariate\",\n              \"model\", \"population\", \"other\"\n            ]\n          },\n          \"change_type\": {\n            \"enum\": [\"source\", \"coverage_subset\", \"covariate_omission\", \"construct_change\"]\n          },\n          \"published\": {\"type\": \"string\"},\n          \"reanalysis\": {\"type\": \"string\"},\n          \"reason\": {\"type\": \"string\"}\n        }\n      }\n    },\n    \"coverage\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"eligible_units\", \"included_units\", \"eligible_times\", \"included_times\",\n        \"rule\", \"notes\"\n      ],\n      \"properties\": {\n        \"eligible_units\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0},\n        \"included_units\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0},\n        \"eligible_times\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0},\n        \"included_times\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0},\n        \"rule\": {\"type\": \"string\"},\n        \"notes\": {\"type\": \"string\"}\n      }\n    },\n    \"effects\": {\n      \"type\": \"array\",\n      \"items\": {\"$ref\": \"#/$defs/effect\"}\n    },\n    \"analysis_diagnostics\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"observations\", \"estimated_parameters\", \"exposure_unique_values\",\n        \"outcome_unique_values\", \"joined_rows\", \"unmatched_outcome_rows\",\n        \"unmatched_exposure_rows\", \"contrast_transformation_verified\",\n        \"reported_variants\"\n      ],\n      \"properties\": {\n        \"observations\": {\"type\": \"integer\", \"minimum\": 1},\n        \"estimated_parameters\": {\"type\": \"integer\", \"minimum\": 1},\n        \"exposure_unique_values\": {\"type\": \"integer\", \"minimum\": 1},\n        \"outcome_unique_values\": {\"type\": \"integer\", \"minimum\": 1},\n        \"joined_rows\": {\"type\": \"integer\", \"minimum\": 1},\n        \"unmatched_outcome_rows\": {\"type\": \"integer\", \"minimum\": 0},\n        \"unmatched_exposure_rows\": {\"type\": \"integer\", \"minimum\": 0},\n        \"contrast_transformation_verified\": {\"const\": true},\n        \"reported_variants\": {\n          \"type\": \"array\", \"minItems\": 1, \"items\": {\"type\": \"string\"},\n          \"uniqueItems\": true\n        }\n      }\n    },\n    \"artifacts\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"code\", \"source_manifest\", \"exposure\", \"analysis_panel\",\n        \"model_output\", \"decision_log\", \"research_notebook\", \"blocker_ledger\", \"fidelity_record\",\n        \"coverage_diagnostics\", \"boundary_route_evidence\", \"study_contract\"\n      ],\n      \"additionalProperties\": {\"type\": [\"string\", \"null\"]}\n    },\n    \"blockers\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"stopping_checklist\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"target_specification_complete\", \"complete_article_checked\",\n        \"outcome_routes_attempted\", \"normal_exposure_source_tested\",\n        \"historical_fallback_applicable\", \"historical_fallback_tested\",\n        \"geographic_batching_applicable\", \"geographic_batching_attempted\",\n        \"fidelity_levels_evaluated\", \"pending_requests\", \"evidence_artifacts\"\n      ],\n      \"properties\": {\n        \"target_specification_complete\": {\"type\": \"boolean\"},\n        \"complete_article_checked\": {\"type\": \"boolean\"},\n        \"outcome_routes_attempted\": {\"type\": \"integer\", \"minimum\": 0},\n        \"normal_exposure_source_tested\": {\"type\": \"boolean\"},\n        \"historical_fallback_applicable\": {\"type\": \"boolean\"},\n        \"historical_fallback_tested\": {\"type\": \"boolean\"},\n        \"geographic_batching_applicable\": {\"type\": \"boolean\"},\n        \"geographic_batching_attempted\": {\"type\": \"boolean\"},\n        \"fidelity_levels_evaluated\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"enum\": [\n              \"matched\", \"source_substitution\", \"reduced_coverage\",\n              \"reduced_adjustment\", \"bounded\", \"supported_sensitivity\"\n            ]\n          }\n        },\n        \"pending_requests\": {\"const\": 0},\n        \"evidence_artifacts\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\"}\n        }\n      }\n    }\n  },\n  \"allOf\": [\n    {\n      \"if\": {\"properties\": {\"status\": {\"enum\": [\"completed_fit\", \"completed_sensitivity\"]}}},\n      \"then\": {\n        \"required\": [\"effects\", \"analysis_diagnostics\"],\n        \"properties\": {\n          \"effects\": {\"minItems\": 1},\n          \"fidelity\": {\"not\": {\"const\": \"none\"}}\n        }\n      }\n    },\n    {\n      \"if\": {\"properties\": {\