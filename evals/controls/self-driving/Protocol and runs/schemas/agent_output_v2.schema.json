{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aeris/agent-output-v3.schema.json",
  "title": "Autonomous source-substitution reanalysis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "status", "fidelity", "target", "sources",
    "substitutions", "coverage", "artifacts", "blockers", "stopping_checklist"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "study_id": {"type": "string"},
    "design_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id", "contract_sha256", "contract_author",
        "geographic_representation",
        "assignment_method", "representative_location_rule",
        "maximum_monitor_distance_km", "monitor_distance_evidence",
        "source_strategy", "exposure_metric", "coverage_policy",
        "decision_rationale", "evidence_basis",
        "locked_before_exposure"
      ],
      "properties": {
        "contract_id": {"type": "string"},
        "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contract_author": {"const": "agent"},
        "geographic_representation": {
          "enum": ["fixed_location", "mobility_trajectory", "administrative_area"]
        },
        "assignment_method": {"type": "string", "minLength": 3},
        "representative_location_rule": {"type": ["string", "null"]},
        "maximum_monitor_distance_km": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 200},
        "monitor_distance_evidence": {"type": "string"},
        "source_strategy": {"enum": ["public_monitor_network", "provider_api", "local_model"]},
        "exposure_metric": {"type": "string", "minLength": 3},
        "coverage_policy": {
          "type": "object",
          "required": ["mode", "minimum_percent", "threshold_source", "evidence"]
        },
        "decision_rationale": {"type": "string", "minLength": 20},
        "evidence_basis": {
          "type": "array", "minItems": 1, "items": {"type": "string"}
        },
        "locked_before_exposure": {"type": "boolean"}
      }
    },
    "status": {
      "enum": [
        "completed_fit", "completed_sensitivity", "completed_blocker",
        "agent_failure", "infrastructure_failure"
      ]
    },
    "fidelity": {
      "enum": [
        "matched", "source_substitution", "reduced_coverage",
        "reduced_adjustment", "bounded", "supported_sensitivity", "none"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome", "pollutant", "geography", "population", "period",
        "effect_scale", "exposure_assignment", "model", "covariates",
        "named_outcome_source", "specification_evidence"
      ],
      "properties": {
        "outcome": {"type": "string"},
        "pollutant": {"type": "string"},
        "geography": {"type": "string"},
        "population": {"type": "string"},
        "period": {"type": "string"},
        "effect_scale": {"type": "string"},
        "exposure_assignment": {"type": "string"},
        "model": {"type": "string"},
        "covariates": {"type": "array", "items": {"type": "string"}},
        "named_outcome_source": {"type": "string"},
        "specification_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "url", "route_origin", "retrieved"],
        "properties": {
          "role": {"enum": ["outcome", "exposure", "covariate", "weather", "boundary", "other"]},
          "url": {"type": "string"},
          "route_origin": {
            "enum": ["article_named", "article_linked", "agent_discovered"]
          },
          "retrieved": {"type": "boolean"},
          "sha256": {"type": ["string", "null"]},
          "evidence_artifact": {"type": ["string", "null"]}
        }
      }
    },
    "substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "change_type", "published", "reanalysis", "reason"],
        "properties": {
          "dimension": {
            "enum": [
              "exposure", "outcome", "geography", "period", "covariate",
              "model", "population", "other"
            ]
          },
          "change_type": {
            "enum": ["source", "coverage_subset", "covariate_omission", "construct_change"]
          },
          "published": {"type": "string"},
          "reanalysis": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_units", "included_units", "eligible_times", "included_times",
        "rule", "notes"
      ],
      "properties": {
        "eligible_units": {"type": ["integer", "null"], "minimum": 0},
        "included_units": {"type": ["integer", "null"], "minimum": 0},
        "eligible_times": {"type": ["integer", "null"], "minimum": 0},
        "included_times": {"type": ["integer", "null"], "minimum": 0},
        "rule": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "effects": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect"}
    },
    "analysis_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations", "estimated_parameters", "exposure_unique_values",
        "outcome_unique_values", "joined_rows", "unmatched_outcome_rows",
        "unmatched_exposure_rows", "contrast_transformation_verified",
        "reported_variants"
      ],
      "properties": {
        "observations": {"type": "integer", "minimum": 1},
        "estimated_parameters": {"type": "integer", "minimum": 1},
        "exposure_unique_values": {"type": "integer", "minimum": 1},
        "outcome_unique_values": {"type": "integer", "minimum": 1},
        "joined_rows": {"type": "integer", "minimum": 1},
        "unmatched_outcome_rows": {"type": "integer", "minimum": 0},
        "unmatched_exposure_rows": {"type": "integer", "minimum": 0},
        "contrast_transformation_verified": {"const": true},
        "reported_variants": {
          "type": "array", "minItems": 1, "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "code", "source_manifest", "exposure", "analysis_panel",
        "model_output", "decision_log", "research_notebook", "blocker_ledger", "fidelity_record",
        "coverage_diagnostics", "boundary_route_evidence", "study_contract"
      ],
      "additionalProperties": {"type": ["string", "null"]}
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "stopping_checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_specification_complete", "complete_article_checked",
        "outcome_routes_attempted", "normal_exposure_source_tested",
        "historical_fallback_applicable", "historical_fallback_tested",
        "geographic_batching_applicable", "geographic_batching_attempted",
        "fidelity_levels_evaluated", "pending_requests", "evidence_artifacts"
      ],
      "properties": {
        "target_specification_complete": {"type": "boolean"},
        "complete_article_checked": {"type": "boolean"},
        "outcome_routes_attempted": {"type": "integer", "minimum": 0},
        "normal_exposure_source_tested": {"type": "boolean"},
        "historical_fallback_applicable": {"type": "boolean"},
        "historical_fallback_tested": {"type": "boolean"},
        "geographic_batching_applicable": {"type": "boolean"},
        "geographic_batching_attempted": {"type": "boolean"},
        "fidelity_levels_evaluated": {
          "type": "array",
          "items": {
            "enum": [
              "matched", "source_substitution", "reduced_coverage",
              "reduced_adjustment", "bounded", "supported_sensitivity"
            ]
          }
        },
        "pending_requests": {"const": 0},
        "evidence_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["completed_fit", "completed_sensitivity"]}}},
      "then": {
        "required": ["effects", "analysis_diagnostics"],
        "properties": {
          "effects": {"minItems": 1},
          "fidelity": {"not": {"const": "none"}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed_blocker"}}},
      "then": {
        "properties": {
          "fidelity": {"const": "none"},
          "stopping_checklist": {
            "properties": {
              "target_specification_complete": {"const": true},
              "complete_article_checked": {"const": true},
              "normal_exposure_source_tested": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label", "primary", "estimate", "ci_low", "ci_high", "scale",
        "contrast", "metric", "native_estimate", "native_ci_low",
        "native_ci_high", "native_scale", "native_contrast"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "primary": {"type": "boolean"},
        "estimate": {"type": "number", "exclusiveMinimum": 0},
        "ci_low": {"type": ["number", "null"]},
        "ci_high": {"type": ["number", "null"]},
        "scale": {"const": "ratio"},
        "contrast": {"type": "string"},
        "metric": {"enum": ["OR", "RR", "outcome_ratio"]},
        "native_estimate": {"type": "number"},
        "native_ci_low": {"type": ["number", "null"]},
        "native_ci_high": {"type": ["number", "null"]},
        "native_scale": {"type": "string"},
        "native_contrast": {"type": "string"}
      }
    }
  }
}
