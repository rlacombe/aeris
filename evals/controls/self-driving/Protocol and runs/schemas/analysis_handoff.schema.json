{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AERIS scientific analysis handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "status", "fidelity", "target", "sources", "substitutions", "coverage", "artifacts", "blockers"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string"},
    "status": {"enum": ["fitted", "sensitivity", "blocked"]},
    "fidelity": {"enum": ["matched", "source_substitution", "reduced_coverage", "reduced_adjustment", "bounded", "supported_sensitivity", "none"]},
    "target": {"$ref": "output.schema.json#/properties/target"},
    "sources": {"$ref": "output.schema.json#/properties/sources"},
    "substitutions": {"$ref": "output.schema.json#/properties/substitutions"},
    "coverage": {"$ref": "output.schema.json#/properties/coverage"},
    "effects": {"$ref": "output.schema.json#/properties/effects"},
    "analysis_diagnostics": {"$ref": "output.schema.json#/properties/analysis_diagnostics"},
    "artifacts": {"$ref": "output.schema.json#/properties/artifacts"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["fitted", "sensitivity"]}}},
      "then": {"required": ["effects", "analysis_diagnostics"], "properties": {"effects": {"minItems": 1}}}
    }
  ]
}
